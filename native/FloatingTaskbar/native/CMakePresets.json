{
  "version": 6,
  "configurePresets": [
    {
      "name": "win-x64",
      "description": "Newest installed Visual Studio generator, x64",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/win-x64"
    },
    {
      "name": "win-x64-ninja",
      "description": "Ninja single-config build, x64 (exports compile_commands.json)",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/build/win-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "win-x64-release", "configurePreset": "win-x64", "configuration": "Release" },
    { "name": "win-x64-debug", "configurePreset": "win-x64", "configuration": "Debug" }
  ]
}
