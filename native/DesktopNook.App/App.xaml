<Application x:Class="DesktopNook.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DesktopNook.App" Startup="OnStartup" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
  <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DesignTokens.xaml"/></ResourceDictionary.MergedDictionaries>
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable, Microsoft YaHei UI, Segoe UI</FontFamily>
    <Style x:Key="NoteOrderHandle" TargetType="Thumb">
      <Setter Property="Cursor" Value="SizeNS" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="DragSurface" Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="5" Padding="8,5">
              <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0">
                  <TextBlock Text="⠿" FontSize="13" Foreground="{DynamicResource AccentInkBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                             Margin="6,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentInkBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="拖动排序" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" TextAlignment="Right" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="DragSurface" Property="Background" Value="{DynamicResource SelectionBrush}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="DragSurface" Property="Background" Value="{DynamicResource SelectionBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>






    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="7" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton x:Name="PageBack" Opacity="0" Focusable="False" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Margin="1" Background="{DynamicResource OutlineBrush}" CornerRadius="3" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton x:Name="PageForward" Opacity="0" Focusable="False" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                <Setter TargetName="PageBack" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                <Setter TargetName="PageForward" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="7" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="UseLayoutRounding" Value="True" /><Setter Property="TextOptions.TextFormattingMode" Value="Display" /><Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
    </Style>
    <Style TargetType="ContextMenu" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DesktopNook.App">
 <Setter Property="Background" Value="{DynamicResource MenuSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
 <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" /><Setter Property="FontSize" Value="12" />
 <Setter Property="UseLayoutRounding" Value="True" /><Setter Property="SnapsToDevicePixels" Value="True" />
 <Setter Property="TextOptions.TextFormattingMode" Value="Display" /><Setter Property="TextOptions.TextRenderingMode" Value="Auto" /><Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
 <Setter Property="MinWidth" Value="202" />
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
  <Grid Margin="6" UseLayoutRounding="True" SnapsToDevicePixels="True">
   <Border CornerRadius="12" Background="{TemplateBinding Background}" IsHitTestVisible="False"><Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity=".13" Color="#233B6A" /></Border.Effect></Border>
   <Border Padding="8" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" RenderOptions.ClearTypeHint="Enabled">
    <DockPanel LastChildFill="True"><Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" CornerRadius="7" Margin="0,0,0,5" Height="32"><Grid Margin="8,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{DynamicResource FoldMark}" Width="17" Height="17" Margin="0,0,7,0"/><TextBlock Text="折页" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></StackPanel><TextBlock Text="操作" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><ScrollViewer MaxHeight="{Binding Path=(local:MenuLayout.BodyHeight),RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="{Binding Path=(local:MenuLayout.BodyWidth),RelativeSource={RelativeSource TemplatedParent}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" /></ScrollViewer></DockPanel>
   </Border>
  </Grid>
 </ControlTemplate></Setter.Value></Setter>
</Style>
    <Style TargetType="Separator">
      <Setter Property="Margin" Value="9,5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="{DynamicResource LineBrush}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DesktopNook.App">
 <Setter Property="UseLayoutRounding" Value="True" /><Setter Property="SnapsToDevicePixels" Value="True" />
 <Setter Property="TextOptions.TextFormattingMode" Value="Display" /><Setter Property="TextOptions.TextRenderingMode" Value="Auto" /><Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
 <Setter Property="MaxWidth" Value="{Binding Path=(local:MenuLayout.BodyWidth),RelativeSource={RelativeSource Self}}" />
 <Setter Property="ToolTip" Value="{Binding Header,RelativeSource={RelativeSource Self}}" />
 <Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" /></DataTemplate></Setter.Value></Setter>
 <Setter Property="Padding" Value="10,7" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Grid>
  <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /></Grid.ColumnDefinitions>
   <TextBlock x:Name="Check" Text="✓" Visibility="Collapsed" FontSize="12" VerticalAlignment="Center" />
   <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
   <TextBlock x:Name="Arrow" Grid.Column="2" Text="›" Visibility="Collapsed" Foreground="#99A8C1" HorizontalAlignment="Right" />
  </Grid></Border>
  <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent}}">
   <Grid Margin="6" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto" TextOptions.TextHintingMode="Fixed">
    <Border CornerRadius="12" Background="{DynamicResource MenuSurfaceBrush}" IsHitTestVisible="False"><Border.Effect><DropShadowEffect BlurRadius="12" Opacity=".13" ShadowDepth="2" /></Border.Effect></Border>
    <Border Padding="8" CornerRadius="12" Background="{DynamicResource MenuSurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" RenderOptions.ClearTypeHint="Enabled">
     <DockPanel LastChildFill="True"><Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" CornerRadius="7" Margin="0,0,0,5" Height="32"><Grid Margin="8,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{DynamicResource FoldMark}" Width="17" Height="17" Margin="0,0,7,0"/><TextBlock Text="折页" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></StackPanel><TextBlock Text="操作" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><ScrollViewer MaxHeight="{Binding Path=(local:MenuLayout.BodyHeight),RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="{Binding Path=(local:MenuLayout.BodyWidth),RelativeSource={RelativeSource TemplatedParent}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" /></ScrollViewer></DockPanel>
    </Border>
   </Grid>
  </Popup>
 </Grid><ControlTemplate.Triggers>
  <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource MenuHoverBrush}" /></Trigger>
  <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
  <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible" /></Trigger>
  <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".78" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4" /></Trigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>


    <Style TargetType="Button">
      <Setter Property="local:UiMotion.Feedback" Value="button"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionHoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".78" /></Trigger><Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CategoryTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="Transparent" BorderThickness="2">
          <Grid><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border x:Name="Indicator" Height="2" Width="16" CornerRadius="1" HorizontalAlignment="Center"
              VerticalAlignment="Bottom" Background="{DynamicResource AccentInkBrush}" IsHitTestVisible="False" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Selector.IsSelected" Value="True"><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="local:UiMotion.Feedback" Value="primary"/>
      <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Padding" Value="12,6" /><Setter Property="MinHeight" Value="34" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="PrimaryChrome" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="2" BorderBrush="Transparent">
              <Grid><Border x:Name="MotionTint" Background="{DynamicResource PrimaryHoverBrush}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PrimaryChrome" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PrimaryChrome" Property="Background" Value="{DynamicResource DisabledBrush}"/><Setter Property="Foreground" Value="{DynamicResource DisabledInkBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="local:UiMotion.Feedback" Value="icon"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Tile" Background="Transparent" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SelectionHoverBrush}" />
                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource LineBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CollectSelectionTile" TargetType="ToggleButton">
      <Setter Property="local:UiMotion.Feedback" Value="tile"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Tile" CornerRadius="9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
          <Grid>
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            <Border x:Name="SelectionMark" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource AccentInkBrush}"
              HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed">
              <Path Data="M3,7 L6,10 L12,4" Stroke="{DynamicResource OnTooltipBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SelectionHoverBrush}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/><Setter TargetName="SelectionMark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="Hover" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" VerticalAlignment="Center"><TextBlock x:Name="Tick" Text="✓" FontSize="12" Foreground="{DynamicResource OnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border>
          <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Background" Value="{DynamicResource SelectionHoverBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}"/><Setter TargetName="Hover" Property="BorderThickness" Value="1"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FoldTaskCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Hit" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
              <Border x:Name="Mark" Width="16" Height="16" CornerRadius="4"
                      Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                <TextBlock x:Name="Tick" Text="✓" FontSize="12" Foreground="{DynamicResource OnMintBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Mark" Property="Background" Value="{DynamicResource FoldMintBrush}" />
                <Setter TargetName="Mark" Property="BorderBrush" Value="{DynamicResource FoldMintBrush}" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="{DynamicResource SelectionHoverBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Mark" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".65" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="8"/></ControlTemplate></ToggleButton.Template></ToggleButton>
        <ContentPresenter Margin="10,8,30,8" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center"/>
        <TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource AccentInkBrush}"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" VerticalOffset="4"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{TemplateBinding ActualWidth}"><ScrollViewer MaxHeight="240" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FoldNewCategory" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="{TemplateBinding Background}">
              <Rectangle x:Name="Outline" Stroke="{DynamicResource OutlineBrush}" StrokeThickness="1"
                         StrokeDashArray="3 3" RadiusX="5" RadiusY="5" IsHitTestVisible="False" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="Stroke" Value="{DynamicResource AccentInkBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="StrokeThickness" Value="2" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FoldNoteAction" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="local:UiMotion.Feedback" Value="button" />
      <Setter Property="Background" Value="{DynamicResource FoldCoralBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnCoralBrush}" />
    </Style>
    <Style x:Key="TaskbarAppearanceSlider" TargetType="Slider">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid x:Name="SliderSurface" Background="Transparent">
              <Border Height="4" Margin="7,0" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource LineBrush}" />
              <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Focusable="False" Command="{x:Static Slider.DecreaseLarge}">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                          <Border Height="4" Margin="7,0,0,0" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource PrimaryBrush}" />
                        </Grid>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Focusable="False" Command="{x:Static Slider.IncreaseLarge}">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="14" VerticalAlignment="Center">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Knob" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource AccentInkBrush}" Background="{DynamicResource SurfaceBrush}" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Background" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
