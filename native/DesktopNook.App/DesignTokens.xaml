<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="CanvasBrush" Color="#F6F9FF"/>
  <SolidColorBrush x:Key="CanvasSubtleBrush" Color="#EFF4FC"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F0F5FC"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#27334A"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#647084"/>
  <SolidColorBrush x:Key="TextFaintBrush" Color="#8A96AA"/>
  <SolidColorBrush x:Key="LineBrush" Color="#DCE5F3"/>
  <SolidColorBrush x:Key="OutlineBrush" Color="#8290A7"/>
  <SolidColorBrush x:Key="PrimaryBrush" Color="#A9C5FA"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#97B8F4"/>
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#84A9EC"/>
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="#1E2E4B"/>
  <SolidColorBrush x:Key="AccentInkBrush" Color="#3D63B0"/>
  <SolidColorBrush x:Key="SelectionBrush" Color="#E2ECFC"/>
  <SolidColorBrush x:Key="SelectionHoverBrush" Color="#EAF1FD"/>
  <SolidColorBrush x:Key="PeachBrush" Color="#FF927E"/>
  <SolidColorBrush x:Key="PeachSoftBrush" Color="#FFE5DF"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#2E7354"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#8A5A12"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#B84655"/>
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEF"/>
  <SolidColorBrush x:Key="DisabledBrush" Color="#EDF0F6"/>
  <SolidColorBrush x:Key="DisabledInkBrush" Color="#647084"/>
  <SolidColorBrush x:Key="TooltipBrush" Color="#27334A"/>
  <SolidColorBrush x:Key="OnTooltipBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="FoldGridLineBrush" Color="#E4E8F5"/>
  <SolidColorBrush x:Key="FoldTitleBrush" Color="#CDD6EB"/>
  <SolidColorBrush x:Key="FoldEdgeBrush" Color="#AEB9D8"/>
  <SolidColorBrush x:Key="FoldCoralBrush" Color="#FF6B8A"/>
  <SolidColorBrush x:Key="OnCoralBrush" Color="#101422"/>
  <SolidColorBrush x:Key="FoldMintBrush" Color="#3AC47D"/>
  <SolidColorBrush x:Key="OnMintBrush" Color="#102C24"/>
  <SolidColorBrush x:Key="FoldCreaseShadeBrush" Color="#1C6C5CE7"/>
  <SolidColorBrush x:Key="FoldCreaseLightBrush" Color="#B8FFFFFF"/>
  <DrawingBrush x:Key="FoldGridPattern" Viewport="0,0,26,26" ViewportUnits="Absolute" TileMode="Tile" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H26 V26 H0 Z"/>
        <GeometryDrawing Brush="{DynamicResource FoldGridLineBrush}" Geometry="M0,0 H26 V1 H1 V26 H0 Z"/>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <DrawingBrush x:Key="FoldRulePattern" Viewport="0,0,32,32" ViewportUnits="Absolute" TileMode="Tile" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H32 V32 H0 Z"/>
        <GeometryDrawing Brush="{DynamicResource FoldGridLineBrush}" Geometry="M0,31 H32 V32 H0 Z"/>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
</ResourceDictionary>
