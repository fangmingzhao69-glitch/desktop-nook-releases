<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <AssemblyName>DesktopNook</AssemblyName><RootNamespace>DesktopNook.App</RootNamespace><Version>0.20.8</Version><Product>DesktopNook</Product><Title>折页</Title><AssemblyTitle>折页</AssemblyTitle><Description>折页 — 常用与灵感，折页之间。</Description>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
    <GiteeMirrorRepository>zfmdx/desktop-nook-releases</GiteeMirrorRepository>
  </PropertyGroup>
  <PropertyGroup>
    <IncludeUiVerification Condition="'$(IncludeUiVerification)' == ''">true</IncludeUiVerification>
    <DefineConstants Condition="'$(IncludeUiVerification)' == 'true'">$(DefineConstants);NOOK_UI_VERIFICATION</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(IncludeUiVerification)' != 'true'">
    <Compile Remove="*Verification.cs" />
    <Compile Include="LiveVerification.cs;OnlineUpdateVerification.cs;PayloadVerification.cs;UpdateVerification.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="DesktopNook.GplLicense" />
    <AssemblyMetadata Include="GiteeMirrorRepository" Value="$(GiteeMirrorRepository)" Condition="'$(GiteeMirrorRepository)' != ''" />
  </ItemGroup>
  <ItemGroup><Page Remove="Assets\AppIconDrawing.xaml;Assets\AppIconSmallDrawing.xaml" /><Resource Include="Assets\AppIconDrawing.xaml" /><None Include="Assets\AppIconSmallDrawing.xaml" /><ProjectReference Include="..\DesktopNook.Core\DesktopNook.Core.csproj" /><Resource Include="Assets\AppIcon.png" /><Resource Include="Assets\AppIcon.ico" /><ProjectReference Include="..\DesktopNook.Games.Core\DesktopNook.Games.Core.csproj" /><EmbeddedResource Include="..\ThirdPartyNotices\DesktopIconBilliards-MIT.txt" LogicalName="DesktopNook.BilliardsLicense" /><EmbeddedResource Include="..\ThirdPartyNotices\BilliardsAudio-CC0.txt" LogicalName="DesktopNook.BilliardsAudioLicense" /><ProjectReference Include="..\DesktopNook.Games.Network\DesktopNook.Games.Network.csproj" /></ItemGroup>
</Project>
