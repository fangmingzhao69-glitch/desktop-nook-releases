<Window x:Class="DesktopNook.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DesktopNook.App" Title="桌面小筑" Width="716.8" Height="627.2" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Icon="Assets/AppIcon.ico" ShowInTaskbar="True" Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" AllowDrop="True" Loaded="OnLoaded" Deactivated="OnDeactivated" StateChanged="OnStateChanged" Closing="OnClosing" PreviewKeyDown="OnKeyDown" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
 <Grid><Viewbox Stretch="Uniform">
  <Border x:Name="Surface" Width="640" Height="560" Background="#F7F9FD" BorderBrush="#DCE4F2" BorderThickness="1" CornerRadius="16" SnapsToDevicePixels="True">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="49"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
    <Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/AppIcon.png" Width="23" Height="23" Margin="0,0,9,0"/><TextBlock Text="我的小筑" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/><TextBlock x:Name="TotalCount" FontSize="10" Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <Button Grid.Column="1" x:Name="CollectButton" Style="{StaticResource PrimaryButton}" Content="＋ 收进小筑" AutomationProperties.AutomationId="Collect" FontSize="12" VerticalAlignment="Center" Click="OnCollect" Margin="8,0"/>
     <Button Grid.Column="2" Content="···" AutomationProperties.Name="更多操作" FontSize="20" VerticalAlignment="Center" Padding="3" Click="OnMore"/>
     <Button Grid.Column="3" Content="−" AutomationProperties.Name="最小化小筑" ToolTip="最小化" FontSize="18" VerticalAlignment="Center" Padding="3" Click="OnMinimizeButton"/>
     <Button Grid.Column="4" Content="×" AutomationProperties.Name="关闭小筑" ToolTip="关闭小筑" FontSize="18" VerticalAlignment="Center" Padding="3" Click="OnCloseButton"/>
    </Grid>
    <Grid Grid.Row="1" Margin="28,0,28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel x:Name="Tabs" Orientation="Horizontal" VerticalAlignment="Top"/></ScrollViewer><Button Grid.Column="1" Content="＋" Padding="3" FontSize="16" VerticalAlignment="Top" AutomationProperties.Name="新建分类" Click="OnNewCategory"/></Grid>
    <Border Grid.Row="2" x:Name="OrderBar" Visibility="Collapsed" Background="#E9EFFC" CornerRadius="6" Padding="10,5" Margin="28,0,28,4"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="取消" Click="OnOrderCancel"/><Button Content="完成" Click="OnOrderDone" Style="{StaticResource PrimaryButton}"/></StackPanel><TextBlock Text="拖动图标调整顺序" FontSize="11" Foreground="#4966B9" VerticalAlignment="Center"/></DockPanel></Border><Grid Grid.Row="3" x:Name="DropSurface" ClipToBounds="True" Background="Transparent" Margin="20,0">
     <ScrollViewer x:Name="IconsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="Icons" VerticalAlignment="Top" Margin="8,12,8,0" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="收纳图标"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Button Tag="{Binding Item}" Style="{StaticResource IconButton}" Height="72" Margin="2,2" Padding="2" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" AutomationProperties.AutomationId="{Binding Id}" Click="OnIconClick" PreviewMouseLeftButtonDown="OnIconDown" PreviewMouseMove="OnIconMove" MouseRightButtonUp="OnIconRightClick">
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><local:ShellIcon IconPath="{Binding Path}" IsRecycleBin="{Binding Recycle}" Width="28" Height="28" Margin="0,0,0,7"/><TextBlock Text="{Binding Name}" Foreground="#526078" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="76" TextAlignment="Center"/></StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"><Image Source="Assets/AppIcon.png" Width="42" Height="42" Opacity=".6"/><TextBlock x:Name="EmptyText" Text="给桌面图标，一个小家" FontSize="12" Foreground="#8998B0" HorizontalAlignment="Center" Margin="0,14,0,8"/><TextBlock Text="将桌面图标拖到这里" FontSize="11" Foreground="#9AA9BF" HorizontalAlignment="Center"/><Button Content="收进小筑" FontSize="11" Click="OnCollect" Margin="0,16,0,0" Foreground="#5876AE" Background="#E6ECF8"/></StackPanel>
     <Border x:Name="OrderMarker" Width="3" Background="#5173DA" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/><Border x:Name="DropOutline" BorderBrush="#8EA9E5" BorderThickness="2" Background="#304F78D9" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
    <Border Grid.Row="4" Background="#EDF2FA" BorderBrush="#DCE3EF" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16"><Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Summary" FontSize="10" Foreground="#8898B4" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="Status" Text="已保存" FontSize="10" Foreground="#8B9DB5" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="365" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/></Grid></Border>
   </Grid>
  </Border>
 </Viewbox><TextBlock x:Name="ResizeHint" Text="◢" FontSize="16" Foreground="#8B9DB5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,5" IsHitTestVisible="False" Visibility="Collapsed"/><Grid x:Name="ResizeHandles" Visibility="Collapsed"/></Grid>
</Window>
