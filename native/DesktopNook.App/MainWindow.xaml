<Window x:Class="DesktopNook.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DesktopNook.App" Title="轻匣" Width="716.8" Height="627.2" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Icon="Assets/AppIcon.ico" ShowInTaskbar="True" Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" AllowDrop="True" Loaded="OnLoaded" Deactivated="OnDeactivated" StateChanged="OnStateChanged" Closing="OnClosing" PreviewKeyDown="OnKeyDown" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
 <Grid><Viewbox Stretch="Uniform">
  <Border x:Name="Surface" Width="640" Height="560" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" SnapsToDevicePixels="True">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="49"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
    <Border Grid.RowSpan="2" Background="{StaticResource HeaderBrush}" CornerRadius="18,18,0,0" IsHitTestVisible="False"/><Border Grid.Row="1" BorderBrush="#E0EEF7" BorderThickness="0,0,0,1" IsHitTestVisible="False"/><Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/AppIcon.png" Width="32" Height="32" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="轻匣" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="桌面有序，常用随手可取" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><Border Background="#DFF2FE" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="TotalCount" FontSize="10" Foreground="#1678B9"/></Border></StackPanel>
     <Button Grid.Column="1" x:Name="CollectButton" Style="{StaticResource PrimaryButton}" Content="＋ 收纳图标" AutomationProperties.AutomationId="Collect" FontSize="12" VerticalAlignment="Center" Click="OnCollect" Margin="8,0"/>
     <Button Grid.Column="2" Content="···" AutomationProperties.Name="更多操作" FontSize="20" VerticalAlignment="Center" Padding="3" Click="OnMore"/>
     <Button Grid.Column="3" Content="−" AutomationProperties.Name="最小化轻匣" ToolTip="最小化" FontSize="18" VerticalAlignment="Center" Padding="3" Click="OnMinimizeButton"/>
     <Button Grid.Column="4" Content="×" AutomationProperties.Name="关闭轻匣" ToolTip="关闭轻匣" FontSize="18" VerticalAlignment="Center" Padding="3" Click="OnCloseButton"/>
    </Grid>
    <Grid Grid.Row="1" Margin="28,0,28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel x:Name="Tabs" Orientation="Horizontal" VerticalAlignment="Top"/></ScrollViewer><Button Grid.Column="1" Content="＋" Padding="3" FontSize="16" VerticalAlignment="Top" AutomationProperties.Name="新建分类" Click="OnNewCategory"/></Grid>
    <Grid Grid.Row="2" x:Name="DropSurface" ClipToBounds="True" Background="Transparent" Margin="20,0">
     <ScrollViewer x:Name="IconsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="Icons" VerticalAlignment="Top" Margin="8,12,8,0" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="收纳图标"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Button Tag="{Binding Item}" Style="{StaticResource IconButton}" Height="72" Margin="2,2" Padding="2" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" AutomationProperties.AutomationId="{Binding Id}" Click="OnIconClick" PreviewMouseLeftButtonDown="OnIconDown" PreviewMouseMove="OnIconMove" MouseRightButtonUp="OnIconRightClick">
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><local:ShellIcon IconPath="{Binding Path}" IsRecycleBin="{Binding Recycle}" Width="28" Height="28" Margin="0,0,0,7"/><TextBlock Text="{Binding Name}" Foreground="#35566E" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="76" TextAlignment="Center"/></StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"><Image Source="Assets/AppIcon.png" Width="54" Height="54" Opacity=".95"/><TextBlock x:Name="EmptyText" Text="把常用图标，放进轻匣" FontSize="12" Foreground="#8998B0" HorizontalAlignment="Center" Margin="0,14,0,8"/><TextBlock Text="将桌面图标拖到这里" FontSize="11" Foreground="#9AA9BF" HorizontalAlignment="Center"/><Button Content="收纳图标" FontSize="11" Click="OnCollect" Margin="0,16,0,0" Foreground="#0875BC" Background="#E2F3FF"/></StackPanel>
     <Border x:Name="OrderMarker" Width="3" Background="#0877DB" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/><Border x:Name="DropOutline" BorderBrush="#39B6E8" BorderThickness="2" Background="#181BA5EB" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
    <Border Grid.Row="3" Background="#F0F7FC" BorderBrush="#D9EAF6" BorderThickness="0,1,0,0" CornerRadius="0,0,18,18"><Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Summary" FontSize="10" Foreground="#748BA0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="Status" Text="已保存" FontSize="10" Foreground="#758CA0" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="365" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/><Button x:Name="UpdateAvailableButton" Grid.Column="2" Visibility="Collapsed" Click="OnUpdateAvailable" AutomationProperties.Name="发现新版本，点击更新" FontSize="11" Foreground="#0875BC" Background="#DFF2FE" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="查看 GitHub 更新说明，确认后下载更新"/></Grid></Border>
   </Grid>
  </Border>
 </Viewbox><TextBlock x:Name="ResizeHint" Text="◢" FontSize="16" Foreground="#758CA0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,5" IsHitTestVisible="False" Visibility="Collapsed"/><Grid x:Name="ResizeHandles" Visibility="Collapsed"/></Grid>
</Window>
