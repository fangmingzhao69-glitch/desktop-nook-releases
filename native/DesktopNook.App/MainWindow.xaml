<Window x:Class="DesktopNook.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:DesktopNook.App" Title="折页" FontFamily="{StaticResource UiFontFamily}"
 TextOptions.TextFormattingMode="Display" Width="1080" Height="620" ResizeMode="NoResize"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" Icon="{DynamicResource FoldMark}"
 ShowInTaskbar="True" Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
 RenderOptions.BitmapScalingMode="HighQuality" AllowDrop="True" Loaded="OnLoaded" Deactivated="OnDeactivated"
 StateChanged="OnStateChanged" Closing="OnClosing" PreviewKeyDown="OnKeyDown" DragOver="OnDragOver"
 DragLeave="OnDragLeave" Drop="OnDrop">
 <Grid>
  <Viewbox Stretch="Uniform">
   <Grid>
    <Border x:Name="Surface" Width="1080" Height="620" Background="{DynamicResource CanvasBrush}"
     BorderBrush="{DynamicResource FoldEdgeBrush}" BorderThickness="1" CornerRadius="14" SnapsToDevicePixels="True">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource FoldTitleBrush}" BorderBrush="{DynamicResource LineBrush}"
       BorderThickness="0,0,0,1" CornerRadius="13,13,0,0">
       <DockPanel Margin="20,0,12,0" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
         <Image Source="{DynamicResource FoldMark}" Width="30" Height="30" Margin="0,0,10,0"/>
         <TextBlock Text="折页" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="ExtraBold" VerticalAlignment="Center"/>
         <TextBlock x:Name="BrandSubtitle" Text="ZHEYE" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
         <Button Height="36" Padding="10,0" Click="OnGamesButton" AutomationProperties.Name="图标台球">
          <StackPanel Orientation="Horizontal"><Path Data="M3,13 L5,7 Q6,5 8,5 H12 Q14,5 15,7 L17,13 Q17,16 15,16 L12,13 H8 L5,16 Q3,16 3,13 M6,9 H10 M8,7 V11 M12,9 H12.1 M14,10.5 H14.1" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><TextBlock Text="图标台球" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/></StackPanel>
         </Button>
         <Button x:Name="SettingsButton" Width="36" Height="36" Padding="0" ToolTip="设置" AutomationProperties.Name="设置" Click="OnSettingsButton">
          <Path Data="M2,4 H16 M2,9 H16 M2,14 H16 M6,2 V6 M12,7 V11 M7,12 V16" Width="17" Height="17" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
         </Button>
         <Border Width="1" Height="20" Background="{DynamicResource LineBrush}" Margin="6,0"/>
         <Button Width="36" Height="36" Padding="0" ToolTip="最小化" AutomationProperties.Name="最小化折页" Click="OnMinimizeButton">
          <Path Data="M2,8 H14" Width="15" Height="15" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
         </Button>
         <Button Width="36" Height="36" Padding="0" ToolTip="关闭" AutomationProperties.Name="关闭折页" Click="OnCloseButton">
          <Path Data="M4,4 L12,12 M12,4 L4,12" Width="16" Height="16" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
         </Button>
        </StackPanel>
       </DockPanel>
      </Border>
      <Grid x:Name="SplitLayout" Grid.Row="1">
       <Grid.ColumnDefinitions><ColumnDefinition x:Name="LauncherColumn" Width="61*"/><ColumnDefinition Width="5"/><ColumnDefinition x:Name="NotesColumn" Width="39*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
       <Rectangle Grid.RowSpan="4" Fill="{DynamicResource FoldGridPattern}" IsHitTestVisible="False"/>
       <Rectangle Grid.Column="2" Grid.RowSpan="4" Margin="0,92,0,36" Fill="{DynamicResource FoldRulePattern}" IsHitTestVisible="False"/>
       <DockPanel Margin="24,0" VerticalAlignment="Center">
        <Button x:Name="CollectButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="Collect" FontSize="12" VerticalAlignment="Center" Click="OnCollect">
         <StackPanel Orientation="Horizontal"><Path Data="M8,2 V14 M2,8 H14" Width="16" Height="16" Stroke="{DynamicResource OnPrimaryBrush}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock Text="添加图标" Margin="4,0,0,0"/></StackPanel>
        </Button>
        <StackPanel>
         <TextBlock Text="桌面收纳" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
         <TextBlock x:Name="TotalCount" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </DockPanel>
       <DockPanel Grid.Row="1" Margin="20,0,18,0" VerticalAlignment="Center">
        <Button DockPanel.Dock="Right" Width="34" Height="34" Padding="0" ToolTip="新建分类" AutomationProperties.Name="新建分类" Click="OnNewCategory">
         <Path Data="M8,2 V14 M2,8 H14" Width="16" Height="16" Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Button>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel x:Name="Tabs" Orientation="Horizontal" VerticalAlignment="Top"/></ScrollViewer>
       </DockPanel>
       <Grid Grid.Row="2" x:Name="DropSurface" ClipToBounds="True" Background="Transparent" Margin="20,0">
        <ScrollViewer x:Name="IconsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <ItemsControl x:Name="Icons" VerticalAlignment="Top" Margin="0,16,0,0" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="添加图标">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
           <Button Tag="{Binding Item}" Style="{StaticResource IconButton}" Height="88" Margin="4,4" Padding="4" ToolTip="{Binding Name}"
            AutomationProperties.Name="{Binding Name}" AutomationProperties.AutomationId="{Binding Id}" Click="OnIconClick"
            PreviewMouseLeftButtonDown="OnIconDown" PreviewMouseMove="OnIconMove" MouseRightButtonUp="OnIconRightClick">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=Button}}">
             <local:ShellIcon IconPath="{Binding Path}" IsRecycleBin="{Binding Recycle}" Width="46" Height="46" Margin="0,0,0,6"/>
             <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="88" TextAlignment="Center"/>
            </StackPanel>
           </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </ScrollViewer>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
         <Image Source="{DynamicResource FoldMark}" Width="56" Height="56"/>
         <TextBlock x:Name="EmptyText" Text="添加常用图标" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,14,0,8"/>
         <TextBlock Text="将桌面图标拖到这里，或点击“添加图标”" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
        <Border x:Name="OrderMarker" Width="3" Background="{DynamicResource AccentInkBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Border x:Name="DropOutline" BorderBrush="{DynamicResource AccentInkBrush}" BorderThickness="2" Background="#183D63B0" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"/>
       </Grid>
       <Border Grid.Row="3" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,0,17">
        <Grid Margin="20,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock x:Name="Summary" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
          <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentInkBrush}" Margin="0,0,6,0"/>
          <TextBlock x:Name="Status" Text="已保存" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
         <Button x:Name="TaskbarNameHelp" Grid.Column="2" Visibility="Collapsed" Click="OnTaskbarNameHelp"
          FontSize="11" Foreground="{DynamicResource AccentInkBrush}" Background="{DynamicResource SelectionBrush}" Padding="8,4"
          Margin="8,0,0,0" VerticalAlignment="Center" Content="修复任务栏旧名称"/>
         <Button x:Name="UpdateAvailableButton" Grid.Column="3" Visibility="Collapsed" Click="OnUpdateAvailable" AutomationProperties.Name="发现新版本，点击更新"
          FontSize="11" Foreground="{DynamicResource AccentInkBrush}" Background="{DynamicResource SelectionBrush}" Padding="8,4"
          Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="查看 GitHub 更新说明，确认后下载更新"/>
        </Grid>
       </Border>
       <Thumb x:Name="NotesSplit" Grid.Column="1" Grid.RowSpan="4" Width="5" HorizontalAlignment="Stretch" Cursor="SizeWE"
        Focusable="False" ToolTip="拖动调整图标与便签宽度" AutomationProperties.Name="图标与便签分隔线"
        DragStarted="OnNotesSplitStarted" DragDelta="OnNotesSplitDelta" DragCompleted="OnNotesSplitCompleted">
        <Thumb.Template>
         <ControlTemplate TargetType="Thumb">
          <Grid Background="Transparent">
           <Border Width="2" HorizontalAlignment="Left" Background="{DynamicResource FoldCreaseShadeBrush}"/>
           <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource FoldCreaseLightBrush}"/>
           <Border Width="1" HorizontalAlignment="Right" Background="{DynamicResource FoldCreaseShadeBrush}"/>
          </Grid>
         </ControlTemplate>
        </Thumb.Template>
       </Thumb>
       <Grid x:Name="NotesHost" Grid.Column="2" Grid.RowSpan="4" PreviewDragOver="OnNotesDrag" PreviewDrop="OnNotesDrag" AllowDrop="True"/>
       <Grid Grid.Column="1" Grid.RowSpan="3" Margin="-6,0,-5,0" Panel.ZIndex="1" IsHitTestVisible="False">
        <Border Width="8" HorizontalAlignment="Left" Background="{DynamicResource FoldCreaseShadeBrush}" Opacity=".52"/>
        <Border Width="5" HorizontalAlignment="Right" Background="{DynamicResource FoldCreaseLightBrush}" Opacity=".4"/>
       </Grid>
      </Grid>
     </Grid>
    </Border>
    <Grid x:Name="ShutterOverlay" Visibility="Collapsed" IsHitTestVisible="False"/>
   </Grid>
  </Viewbox>
  <TextBlock x:Name="ResizeHint" Text="◢" FontSize="16" Foreground="{DynamicResource TextFaintBrush}"
    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,5" IsHitTestVisible="False" Visibility="Collapsed"/>
  <Grid x:Name="ResizeHandles" Visibility="Collapsed"/>
 </Grid>
</Window>
